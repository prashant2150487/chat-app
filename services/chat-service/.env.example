PORT=5004

DATABASE_URL="mysql://<user>:<password>@localhost:3306/chat_db"

# Must match auth-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me
JWT_EXPIRES_IN=15m

# Must match auth-service INTERNAL_SERVICE_SECRET
INTERNAL_SERVICE_SECRET=change-me-internal-secret

# Comma-separated origins allowed for Socket.IO
SOCKET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
