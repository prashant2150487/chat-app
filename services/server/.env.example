PORT=8000

DATABASE_URL="mysql://<user>:<password>@localhost:3306/chat_db"

JWT_ACCESS_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

INTERNAL_SERVICE_SECRET=change-me-internal-secret

SOCKET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: SMTP_SECURE=true for port 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
